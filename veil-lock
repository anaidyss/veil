#!/usr/bin/env bash
# launches veil, the ext-session-lock-v1 lockscreen (python + pywayland)
#
# niri holds the session, so if you kill the locker the screen stays
# locked (maroon background). emergency exit without a reboot:
#   Ctrl+Alt+F3, log into a TTY, then
#   XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 hyprlock
#
# deps: sudo dnf install python3-psutil python3-pam python3-pillow
#       pywayland lives in ~/.local/share/veil/venv
# old TUI version: ~/.local/bin/veil_ui.py (needs python3-textual)

# force US: the keymap in the locker is US-based (same as in lock.sh)
niri msg action switch-layout 0 2>/dev/null

# don't let the log grow forever
LOG="$HOME/.local/share/veil/veil.log"
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    : > "$LOG"
fi

exec ~/.local/share/veil/venv/bin/python ~/.local/share/veil/veil_lock.py \
    2>>"$LOG"
